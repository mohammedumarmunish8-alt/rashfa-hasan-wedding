rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function admin() { return request.auth != null && request.auth.token.admin == true; }
    match /invitationShares/{id} {
      allow create: if admin()
        && request.resource.data.keys().hasAll(['uid','email','guest','invitedBy','createdAt'])
        && request.resource.data.keys().hasOnly(['uid','email','guest','invitedBy','createdAt'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.guest is string && request.resource.data.guest.size() > 0 && request.resource.data.guest.size() <= 80
        && request.resource.data.invitedBy is string && request.resource.data.invitedBy.size() <= 50
        && request.resource.data.createdAt == request.time;
      allow read: if admin() && request.auth.token.role == 'super_admin';
      allow update, delete: if false;
    }
    match /rsvps/{id} {
      allow create: if request.resource.data.keys().hasOnly(['name','attendance','guests','invitedBy','createdAt'])
        && request.resource.data.name is string && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 80
        && request.resource.data.attendance in ['yes','no']
        && request.resource.data.guests is int && request.resource.data.guests >= 1 && request.resource.data.guests <= 20
        && request.resource.data.invitedBy is string && request.resource.data.invitedBy.size() <= 50
        && request.resource.data.createdAt is string;
      allow read, update, delete: if admin();
    }
    match /wishes/{id} {
      allow create: if request.resource.data.keys().hasOnly(['name','message','createdAt','approved'])
        && request.resource.data.name is string && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 80
        && request.resource.data.message is string && request.resource.data.message.size() > 0 && request.resource.data.message.size() <= 500
        && request.resource.data.createdAt is string && request.resource.data.approved == false;
      allow read: if admin() || resource.data.approved == true;
      allow update, delete: if admin();
    }
  }
}
